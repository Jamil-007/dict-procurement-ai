# Root-level gitignore for monorepo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# OS
.DS_Store
Thumbs.db
*.tmp

# Playwright / MCP scratch output
.playwright-mcp/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Archives
*.zip
*.tar.gz
*.rar

# Reference PDFs — laws, issuances and manuals. Staging area for building the
# knowledge index; the documents themselves live in the bucket under
# knowledge/, not in the repo. See backend/data/knowledge_sources.json for
# what belongs here and backend/scripts/build_knowledge_index.py to rebuild.
Reference/

# docs/ is published, so only the per-dimension briefs belong in it. All other
# working notes — specs, plans, mockups, agent instructions — stay out of the
# repo. Ignore everything under docs/ and allow the briefs back in.
docs/*
!docs/dimension-*.md

# Agent worktrees and orchestration scratch — not committed
.claude/
.superpowers/
