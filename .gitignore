# Root-level gitignore for monorepo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# OS
.DS_Store
Thumbs.db
*.tmp

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Archives
*.zip
*.tar.gz
*.rar

# Local docs, specs, plans, mockups and source form templates — not committed
docs/

# Agent worktrees and orchestration scratch — not committed
.claude/
.superpowers/
