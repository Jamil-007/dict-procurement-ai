# Root-level gitignore for monorepo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# OS
.DS_Store
Thumbs.db
*.tmp

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Archives
*.zip
*.tar.gz
*.rar

# Reference PDFs — laws, issuances and manuals. Staging area for building the
# knowledge index; the documents themselves live in the bucket under
# knowledge/, not in the repo. See backend/data/knowledge_sources.json for
# what belongs here and backend/scripts/build_knowledge_index.py to rebuild.
Reference/

# docs/ is working-notes only on the integration branch: agent instructions,
# infrastructure requests, audience-specific overviews, and the per-dimension
# specs/briefs all stay on disk and out of the repo. Ignore everything under
# docs/ so a new note is excluded by default rather than having to be remembered.
docs/*
.docs/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Backend runtime state: uploaded documents and the OCR cache. Reproducible,
# and some of it is real government procurement material.
backend/uploads/
backend/cache/

# The sessions/findings/checkpoints database (settings.DB_PATH defaults to
# backend/data/procurement.db). Scoped to the database files rather than the
# whole of backend/data/, which also holds the committed knowledge index.
*.db
*.db-shm
*.db-wal
