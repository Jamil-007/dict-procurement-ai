# Root-level gitignore for monorepo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# OS
.DS_Store
Thumbs.db
*.tmp

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Archives
*.zip
*.tar.gz
*.rar

# Docs
.docs/
docs/
# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Backend runtime state: uploaded documents, the OCR cache and the
# sessions/findings database. All of it is reproducible and some of it is
# real government procurement material.
backend/uploads/
backend/cache/
backend/data/
*.db
*.db-shm
*.db-wal
