# LLM Provider (vertex_ai or anthropic)
LLM_PROVIDER=anthropic  # Use anthropic during development until Vertex AI is set up

# Vertex AI (for production)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Credentials. Leave GOOGLE_APPLICATION_CREDENTIALS unset:
#   locally    — run `gcloud auth application-default login` once and the
#                Google libraries find your own credentials.
#   Cloud Run  — the attached service account is used automatically.
# Pointing it at a downloaded service-account key is a long-lived secret on
# disk, and it silently overrides the two mechanisms above. If one is already
# set machine-wide, start the API with:
#   env -u GOOGLE_APPLICATION_CREDENTIALS uvicorn server:app
# GOOGLE_APPLICATION_CREDENTIALS=

# Anthropic (fallback for development)
ANTHROPIC_API_KEY=your-anthropic-key

# Tavily
TAVILY_API_KEY=your-tavily-key

# Gamma (optional for MVP)
GAMMA_API_KEY=your-gamma-key

# Storage
UPLOAD_DIR=./uploads

# --- Storage -----------------------------------------------------------
# The defaults below need no GCP resources and no credentials. Nothing you do
# locally can reach shared data unless you deliberately change them.

# Procurement records, findings and the Knowledge Hub.
#   memory    — in-process, wiped on restart. Fine for local work.
#   firestore — persistent. Needs GOOGLE_CLOUD_PROJECT and credentials, or the
#               emulator below.
STORE_BACKEND=memory

# Which Firestore database to use. ai-innov-474401 gives each application its
# own named database rather than sharing (default), so this must be set when
# STORE_BACKEND=firestore. The app refuses to start otherwise, so a
# misconfiguration cannot write into another team's data.
FIRESTORE_DATABASE=

# Namespaces every collection, so staging and prod can share one database.
# Leave empty on prod; set to staging_ on staging.
FIRESTORE_PREFIX=

# Want persistence locally? Use the emulator rather than a real database. It
# is a throwaway on your own machine — no credentials, no GCP resources, and
# no way to touch anyone else's records. Run:
#   gcloud emulators firestore start --host-port=127.0.0.1:8098
# then uncomment both lines. FIRESTORE_DATABASE stays empty because the
# emulator has only (default). Note config.py copies this into os.environ at
# import: the Google client only reads the real environment, so setting it here
# alone would be ignored and you would quietly hit the real database instead.
# STORE_BACKEND=firestore
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8098

# Where uploaded PDFs and the Knowledge Hub documents live. Empty means local
# disk under UPLOAD_DIR, which is the right default: the bucket is shared, so
# your test uploads would show up in everyone's Documents tab.
# Independent of STORE_BACKEND — the bucket can hold files while records are
# still in memory. Set it to ai-procurement only if you specifically need to
# work against real storage, and note that whoever runs the app needs
# roles/storage.objectAdmin on the bucket or uploads fail with 403.
GCS_BUCKET=

# State Persistence
STATE_STORAGE=memory  # memory, sqlite, or postgres

# Chat context limit
CHAT_PARSED_TEXT_LIMIT=150000
